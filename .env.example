# Bu dosya şablondur, gerçek değer içermez. Kopyala:
#   cp .env.example .env
# Üretimde bu değişkenler platformun (Vercel/Railway) ortam değişkeni
# panelinden verilir, dosyayla değil.

# PostgreSQL bağlantı adresi.
# Serverless'a taşındığında havuzlanmış (pooled) adres kullanılmalı — Neon ve
# Supabase ayrı bir "pooler" adresi veriyor. Doğrudan bağlantı adresiyle
# fonksiyonlar veritabanının bağlantı limitini tüketir.
DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/sistemgaraj

# JWT imzalama anahtarı. Rastgele ve uzun olmalı; tahmin edilebilir bir değer
# herkesin kendine token üretebilmesi demektir. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Değiştirildiğinde mevcut tüm oturumlar geçersiz olur, herkes çıkış yapar.
JWT_SECRET=

# API'nin dinleyeceği port. Vercel/Railway bunu kendisi verir.
PORT=4000

# Tarayıcıdan istek atmasına izin verilen origin'ler, virgülle ayrılır.
# Tanımsız bırakılırsa yalnızca http://localhost:3000 kabul edilir.
# Üretim örneği: https://sistemgaraj.com,https://www.sistemgaraj.com
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# GÖRSEL DEPOLAMA (Supabase Storage)
#
# Bu üçü tanımlı DEĞİLSE görseller yerel `uploads/` klasörüne yazılır ve API
# tarafından servis edilir. Yani Supabase hesabı olmadan da geliştirme
# yapabilirsin — üretimde ise zorunlu, çünkü sunucusuz ortamda disk
# salt-okunur ve geçici.
#
# SUPABASE_SERVICE_ROLE_KEY yönetici yetkisine sahiptir: yalnızca sunucuda
# durmalı, asla frontend'e veya depoya girmemeli.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=images
