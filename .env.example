# Bu dosya şablondur, gerçek değer içermez. Kopyala:
#   cp .env.example .env
# Üretimde bu değişkenler platformun (Vercel/Railway) ortam değişkeni
# panelinden verilir, dosyayla değil.

# PostgreSQL — iki adres gerekiyor.
#
# DATABASE_URL: uygulamanın kullandığı havuzlanmış (pooler) adres. Supabase'de
#   port 6543, sonuna ?pgbouncer=true eklenir. Sunucusuz ortamda her istek yeni
#   bir fonksiyon örneği açabildiği için doğrudan bağlantı limiti tüketir.
#
# DIRECT_URL: migration ve introspection için doğrudan adres, port 5432.
#   Havuzlayıcı hazırlanmış ifadeleri desteklemediği için şema değişiklikleri
#   oradan geçemez.
#
# Yerel geliştirmede havuzlayıcı yok — ikisine de aynı adresi ver.
DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/sistemgaraj
DIRECT_URL=postgresql://kullanici:sifre@localhost:5432/sistemgaraj

# JWT imzalama anahtarı. Rastgele ve uzun olmalı; tahmin edilebilir bir değer
# herkesin kendine token üretebilmesi demektir. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Değiştirildiğinde mevcut tüm oturumlar geçersiz olur, herkes çıkış yapar.
JWT_SECRET=

# API'nin dinleyeceği port. Vercel/Railway bunu kendisi verir.
PORT=4000

# Tarayıcıdan istek atmasına izin verilen origin'ler, virgülle ayrılır.
# Tanımsız bırakılırsa yalnızca http://localhost:3000 kabul edilir.
# Üretim örneği: https://sistemgaraj.com,https://www.sistemgaraj.com
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# GÖRSEL DEPOLAMA (Supabase Storage)
#
# Bu üçü tanımlı DEĞİLSE görseller yerel `uploads/` klasörüne yazılır ve API
# tarafından servis edilir. Yani Supabase hesabı olmadan da geliştirme
# yapabilirsin — üretimde ise zorunlu, çünkü sunucusuz ortamda disk
# salt-okunur ve geçici.
#
# SUPABASE_SERVICE_ROLE_KEY yönetici yetkisine sahiptir: yalnızca sunucuda
# durmalı, asla frontend'e veya depoya girmemeli.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=images

# ---------------------------------------------------------------------------
# HIZ SINIRI DEPOSU (Upstash Redis)
#
# Tanımlı DEĞİLSE sayaçlar süreç belleğinde tutulur — tek sunucuda doğru
# çalışır, yerel geliştirme için yeterli. Sunucusuz ortamda ise her fonksiyon
# örneği kendi belleğiyle açıldığından sınır fiilen "örnek sayısı × sınır"
# olur; orada paylaşımlı depo zorunlu.
#
# Upstash panelinde veritabanını fonksiyonlarla aynı bölgede (eu-central-1)
# aç — her istek buraya da bir tur atıyor.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
