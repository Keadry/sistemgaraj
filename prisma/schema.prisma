// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
// ROL
// ==============================
enum Role {
  USER
  MODERATOR
  ADMIN
}

// ==============================
// YORUM DURUMU
// ==============================
enum CommentStatus {
  APPROVED
  PENDING
  REJECTED
}

// ==============================
// KULLANICI
// ==============================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  avatarUrl String?
  coverUrl  String?
  bio         String?
  twitterUrl  String?
  githubUrl   String?
  steamUrl    String?
  discordUrl  String?
  websiteUrl  String?
  language              String  @default("tr")
  emailNewsletterOptIn  Boolean @default(false)
  emailNotifyOnActivity Boolean @default(true)
  notifyOnBuildComment  Boolean @default(true)
  notifyOnBuildLike     Boolean @default(true)
  birthDate            DateTime?
  showBirthDate        Boolean   @default(false)
  showOnlineStatus     Boolean   @default(true)
  showLastActive       Boolean   @default(true)
  lastActiveAt         DateTime?
  password  String
  role      Role     @default(USER)

  isBanned   Boolean   @default(false)
  banReason  String?
  mutedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  builds   Build[]
  likes    Like[]
  comments Comment[]
  buildCommentLikes CommentLike[]

  bookmarks BuildBookmark[]

  blockedUsers UserBlock[] @relation("Blocker")
  blockedByUsers UserBlock[] @relation("Blocked")

  profileCommentsAuthored ProfileComment[] @relation("ProfileCommentAuthor")
  profileCommentsReceived ProfileComment[] @relation("ProfileCommentTarget")
}

// ==============================
// PARÇA (Bileşen)
// ==============================
enum ComponentType {
  CPU
  MOTHERBOARD
  RAM
  GPU
  PSU
  CASE
  STORAGE
  COOLER
}

// ==============================
// BILESEN BILGI
// ==============================
model Component {
  id        String        @id @default(cuid())
  name      String
  brand     String
  type      ComponentType
  price     Float
  imageUrl  String?
  sourceUrl String? // Scraper'ın çektiği orijinal ürün linki

  socket     String? // CPU / Motherboard soket uyumu için (örn: "AM5", "LGA1700")
  ramType    String? // Motherboard / RAM için (örn: "DDR5", "DDR4")
  wattage    Int? // GPU / CPU'nun tükettiği güç, PSU'nun sağladığı güç
  formFactor String? // Motherboard / Case boyutu için (örn: "ATX", "Micro-ATX")
  ramSlots   Int?  // Motherboard / RAM SLOT KONTROLU
  m2Slots    Int? // Motherboard / M.2 SLOT KONTROLU
  sataSlots  Int? // Motherboard / SATA SLOT KONTROLU

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildComponents BuildComponent[]
}

// ==============================
// TOPLANAN SİSTEM
// ==============================
model Build {
  id           String        @id @default(cuid())
  name         String
  description  String?
  totalPrice   Float
  isPublic     Boolean       @default(true)
  isFeatured   Boolean       @default(false)
  reviewStatus CommentStatus @default(APPROVED)
  createdAt    DateTime      @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  components   BuildComponent[]
  
  likes        Like[]
  comments     Comment[]
  images       BuildImage[]
  editRequests BuildEditRequest[]

  bookmarks  BuildBookmark[]
}

// ==============================
// ARA TABLO: Build <-> Component (Many-to-Many)
// ==============================
model BuildComponent {
  id String @id @default(cuid())

  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String

  component   Component @relation(fields: [componentId], references: [id])
  componentId String

  quantity   Int           @default(1)
  note       String?
  noteStatus CommentStatus @default(APPROVED)

  @@unique([buildId, componentId])
}

// ==============================
// SISTEM RESMI
// ==============================
model BuildImage {
  id        String        @id @default(cuid())
  url       String
  isMain    Boolean       @default(false)
  status    CommentStatus @default(PENDING)
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String
}

// ==============================
// BEĞENİ
// ==============================
model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String

  @@unique([userId, buildId]) // Aynı kullanıcı aynı sistemi 2 kere beğenemez
}

// ==============================
// YORUM
// ==============================
model Comment {
  id           String        @id @default(cuid())
  content      String
  status       CommentStatus @default(APPROVED)
  createdAt    DateTime      @default(now())
  lastEditedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String

  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  replies  Comment[] @relation("CommentReplies")

  likes CommentLike[]
}

model CommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String

  @@unique([userId, commentId])
}


model BuildEditRequest {
  id          String        @id @default(cuid())
  status      CommentStatus @default(PENDING)
  name        String?
  description String?
  createdAt   DateTime      @default(now())
  reviewedAt  DateTime?

  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String

  cpuId         String?
  motherboardId String?
  ramIds        String[] @default([])
  gpuId         String?
  psuId         String?
  caseId        String?
  storageId     String[] @default([])

  images BuildEditRequestImage[]
  notes  BuildEditRequestNote[]
}

model BuildEditRequestImage {
  id    String @id @default(cuid())
  url   String
  order Int    @default(0)

  request   BuildEditRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
}

model BuildEditRequestNote {
  id            String        @id @default(cuid())
  componentType ComponentType
  note          String

  request   BuildEditRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
}

model ProfileComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  author   User   @relation("ProfileCommentAuthor", fields: [authorId], references: [id])
  authorId String

  profileUser   User   @relation("ProfileCommentTarget", fields: [profileUserId], references: [id])
  profileUserId String

  parent   ProfileComment?  @relation("ProfileCommentReplies", fields: [parentId], references: [id])
  parentId String?
  replies  ProfileComment[] @relation("ProfileCommentReplies")
}

model UserBlock {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String

  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String

  @@unique([blockerId, blockedId])
}

model BuildBookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String

  @@unique([userId, buildId])
}
