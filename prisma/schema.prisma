// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"

  // Uygulamanın kullandığı bağlantı. Sunucusuz ortamda her istek yeni bir
  // fonksiyon örneği açabildiği için doğrudan bağlantı kullanılırsa
  // veritabanının bağlantı limiti hızla tükenir; bu yüzden havuzlanmış
  // (pooler) adres verilir.
  url = env("DATABASE_URL")

  // Migration ve introspection için doğrudan bağlantı. Havuzlayıcı
  // (pgBouncer) hazırlanmış ifadeleri ve bazı DDL işlemlerini desteklemediği
  // için şema değişiklikleri havuz üzerinden çalıştırılamaz.
  // Yerel geliştirmede havuzlayıcı yok — ikisine de aynı adresi verebilirsin.
  directUrl = env("DIRECT_URL")
}

// ==============================
// ROL
// ==============================
enum Role {
  USER
  MODERATOR
  ADMIN
}

// ==============================
// YORUM DURUMU
// ==============================
enum CommentStatus {
  APPROVED
  PENDING
  REJECTED
}

// ==============================
// KULLANICI
// ==============================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  avatarUrl String?
  coverUrl  String?
  bio         String?
  twitterUrl  String?
  githubUrl   String?
  steamUrl    String?
  discordUrl  String?
  websiteUrl  String?
  language              String  @default("tr")
  emailNewsletterOptIn  Boolean @default(false)
  emailNotifyOnActivity Boolean @default(true)
  notifyOnBuildComment  Boolean @default(true)
  notifyOnBuildLike     Boolean @default(true)
  birthDate            DateTime?
  showBirthDate        Boolean   @default(false)
  showOnlineStatus     Boolean   @default(true)
  showLastActive       Boolean   @default(true)
  lastActiveAt         DateTime?
  password  String
  role      Role     @default(USER)

  isBanned   Boolean   @default(false)
  banReason  String?
  mutedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  builds   Build[]
  likes    Like[]
  comments Comment[]
  buildCommentLikes CommentLike[]

  bookmarks BuildBookmark[]

  blockedUsers UserBlock[] @relation("Blocker")
  blockedByUsers UserBlock[] @relation("Blocked")

  profileCommentsAuthored ProfileComment[] @relation("ProfileCommentAuthor")
  profileCommentsReceived ProfileComment[] @relation("ProfileCommentTarget")

  notifications      Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")

  commentMentions CommentMention[]
}

// ==============================
// BİLDİRİM
// ==============================
enum NotificationType {
  BUILD_COMMENT // sistemine yorum geldi
  BUILD_PART_COMMENT // sistemindeki belirli bir parça hakkında yorum geldi
  COMMENT_REPLY // yorumuna yanıt geldi
  MENTION // bir yorumda etiketlendin
  BUILD_LIKE // sistemi beğenildi
  COMMENT_LIKE // yorumu beğenildi
  BUILD_APPROVED // sistemi yayına alındı
  BUILD_REJECTED // sistemi reddedildi
  EDIT_APPROVED // düzenleme talebi onaylandı
  EDIT_REJECTED // düzenleme talebi reddedildi
  ANNOUNCEMENT // yönetimden duyuru
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  /// Duyuru bildirimlerinde serbest metin taşır; diğerlerinde metin
  /// istemcide türden üretiliyor ki dil değişince eski kayıtlar da güncellensin.
  message String?

  /// Bildirimi alan kişi.
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// Eylemi yapan kişi. Moderasyon ve duyurularda boş — onları bir kullanıcı
  /// değil sistem tetikliyor.
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  actorId String?

  /// Nereye götüreceği. Kaynak silinince bildirim de gitsin diye cascade:
  /// tıklandığında var olmayan bir sayfaya düşen bildirim, bildirim değil.
  build   Build?  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String?

  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String?

  /// Çan her sayfa yüklemesinde okunmamış sayısını soruyor; sorgu tam olarak
  /// bu üçlüyü kullanıyor.
  @@index([userId, isRead, createdAt])
}

// ==============================
// PARÇA (Bileşen)
// ==============================
enum ComponentType {
  CPU
  MOTHERBOARD
  RAM
  GPU
  PSU
  CASE
  STORAGE
  COOLER
}

// ==============================
// BILESEN BILGI
// ==============================
model Component {
  id        String        @id @default(cuid())
  name      String
  brand     String
  type      ComponentType
  price     Float
  imageUrl  String?
  sourceUrl String? // Scraper'ın çektiği orijinal ürün linki

  socket     String? // CPU / Motherboard soket uyumu için (örn: "AM5", "LGA1700")
  ramType    String? // Motherboard / RAM için (örn: "DDR5", "DDR4")
  wattage    Int? // GPU / CPU'nun tükettiği güç, PSU'nun sağladığı güç
  formFactor String? // Motherboard / Case boyutu için (örn: "ATX", "Micro-ATX")
  ramSlots   Int?  // Motherboard / RAM SLOT KONTROLU
  m2Slots    Int? // Motherboard / M.2 SLOT KONTROLU
  sataSlots  Int? // Motherboard / SATA SLOT KONTROLU

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildComponents BuildComponent[]

  /// Bu parça hakkında yazılmış yorumlar (bkz. `Comment.component`).
  taggedInComments Comment[]
}

// ==============================
// TOPLANAN SİSTEM
// ==============================
model Build {
  id           String        @id @default(cuid())
  name         String
  description  String?
  totalPrice   Float
  isPublic     Boolean       @default(true)
  isFeatured   Boolean       @default(false)
  reviewStatus CommentStatus @default(APPROVED)
  createdAt    DateTime      @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  components   BuildComponent[]
  
  likes        Like[]
  comments     Comment[]
  images       BuildImage[]
  editRequests BuildEditRequest[]

  bookmarks  BuildBookmark[]

  notifications Notification[]
}

// ==============================
// ARA TABLO: Build <-> Component (Many-to-Many)
// ==============================
model BuildComponent {
  id String @id @default(cuid())

  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String

  component   Component @relation(fields: [componentId], references: [id])
  componentId String

  quantity   Int           @default(1)
  note       String?
  noteStatus CommentStatus @default(APPROVED)

  @@unique([buildId, componentId])
}

// ==============================
// SISTEM RESMI
// ==============================
model BuildImage {
  id        String        @id @default(cuid())
  url       String
  isMain    Boolean       @default(false)
  status    CommentStatus @default(PENDING)
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String
}

// ==============================
// BEĞENİ
// ==============================
model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String

  @@unique([userId, buildId]) // Aynı kullanıcı aynı sistemi 2 kere beğenemez
}

// ==============================
// YORUM
// ==============================
model Comment {
  id           String        @id @default(cuid())
  content      String
  status       CommentStatus @default(APPROVED)
  createdAt    DateTime      @default(now())
  lastEditedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String

  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  replies  Comment[] @relation("CommentReplies")

  /// Yorumun belirli bir parça hakkında olduğunu işaretler ("bu ekran kartı
  /// neden bu kasaya sığmıyor?"). Parça silinirse yorum kalıyor, yalnızca
  /// etiket düşüyor: soruya verilmiş yanıtlar hâlâ okunabilir olmalı.
  component   Component? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  componentId String?

  likes    CommentLike[]
  mentions CommentMention[]

  notifications Notification[]
}

// ==============================
// YORUMDA KULLANICI ETİKETLEME (@mention)
// ==============================
/// Metindeki `@kullanıcı` parçalarının **çözümlenmiş** hali. Metnin kendisi
/// yeterli değil: hangi etiketin gerçek bir hesaba karşılık geldiğini her
/// okuma yolunda yeniden çözmek gerekirdi, ve yorum düzenlenince kimin daha
/// önce bildirim aldığı bilinemezdi — aynı kişiye ikinci bildirim giderdi.
model CommentMention {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// Aynı yorumda aynı kişiyi iki kez yazmak tek etiket sayılır.
  @@unique([commentId, userId])
}

model CommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String

  @@unique([userId, commentId])
}


model BuildEditRequest {
  id          String        @id @default(cuid())
  status      CommentStatus @default(PENDING)
  name        String?
  description String?
  createdAt   DateTime      @default(now())
  reviewedAt  DateTime?

  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String

  cpuId         String?
  motherboardId String?
  ramIds        String[] @default([])
  gpuId         String?
  psuId         String?
  caseId        String?
  storageId     String[] @default([])

  images BuildEditRequestImage[]
  notes  BuildEditRequestNote[]
}

model BuildEditRequestImage {
  id    String @id @default(cuid())
  url   String
  order Int    @default(0)

  request   BuildEditRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
}

model BuildEditRequestNote {
  id            String        @id @default(cuid())
  componentType ComponentType
  note          String

  request   BuildEditRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
}

model ProfileComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  author   User   @relation("ProfileCommentAuthor", fields: [authorId], references: [id])
  authorId String

  profileUser   User   @relation("ProfileCommentTarget", fields: [profileUserId], references: [id])
  profileUserId String

  parent   ProfileComment?  @relation("ProfileCommentReplies", fields: [parentId], references: [id])
  parentId String?
  replies  ProfileComment[] @relation("ProfileCommentReplies")
}

model UserBlock {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String

  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String

  @@unique([blockerId, blockedId])
}

model BuildBookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String

  @@unique([userId, buildId])
}
